# Configuration Server Port
PORT=8080
APP_PORT=8080

# Database MySQL Credentials
DB_HOST=153.92.15.57
DB_PORT=3306
DB_USER=[USERNAME]
DB_PASSWORD=[PASSWORD]
DB_NAME=[NAME]

# Database Connection Pool Settings
DB_MAX_IDLE_CONNS=10
DB_MAX_OPEN_CONNS=25
DB_CONN_MAX_LIFETIME=3m
DB_CONN_MAX_IDLE_TIME=1m

# Database startup retry policy (useful in container orchestration)
DB_CONNECT_RETRIES=10
DB_CONNECT_RETRY_DELAY=3s

# CORS Security (Comma-separated origins, or * for all)
CORS_ALLOWED_ORIGINS=*

# Set to "true" only if you want GORM to auto-create/alter tables based on
# the Go models. Leave as false/unset to just connect to the existing,
# already-finalized schema without touching it.
AUTO_MIGRATE=false

# Google Gemini Vision API (fitur auto-fill laporan)
# Dapatkan API key dari: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Model Vision yang dipakai. Default fallback: gemini-3.6-flash
GEMINI_MODEL=gemini-3.6-flash
# Optional: override prompt auto-fill. Gunakan {{categories}} sebagai
# placeholder untuk daftar kategori dari tabel categories.
GEMINI_AUTOFILL_PROMPT=
# Structured output (responseSchema + responseMimeType). Set "false" untuk
# model yang tidak support JSON mode (fallback ke prompt + parser).
GEMINI_JSON_MODE=true
# Timeout request ke Gemini (detik). Default 60. Naikkan kalau model lambat.
GEMINI_TIMEOUT_SECONDS=60
# Thinking level untuk model Gemini 3.x: minimal/low/medium/high.
# Set "off" untuk menonaktifkan thinking (lebih cepat).
GEMINI_THINKING_LEVEL=minimal

# Upload storage & JWT (tambahan dari default lokal)
# UPLOAD_DIR=./uploads
# STORAGE_BASE_URL=/uploads
# MAX_UPLOAD_SIZE_MB=5
# JWT_SECRET=ubah-ini
# JWT_EXPIRATION_HOURS=24

